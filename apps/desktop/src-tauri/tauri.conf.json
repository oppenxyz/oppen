{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oppen",
  "version": "0.1.0",
  "identifier": "xyz.oppen.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "oppen",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3NjY1MjlCQkM2MDFFOTQKUldTVUhtQzhtMUptTjIyekU5SEt3ZlFnRm9SNkVhbHlsR21IbDVNUHl4bG55T2pSUGVoQzNxYWIK",
      "endpoints": []
    }
  }
}
