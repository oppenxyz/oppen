  {
    "name": "py/test_phantom_agent_creation_matches_production",
    "source_url": "https://github.com/hyperliquid-dex/hyperliquid-python-sdk/blob/master/tests/signing_test.py",
    "source_commit": "2fdb18f9517675ea03695a0962bd19eece9c83f0",
    "network": "mainnet",
    "kind": "l1",
    "private_key": null,
    "action": {
      "type": "order",
      "orders": [
        {
          "a": 4,
          "b": true,
          "p": "1670.1",
          "s": "0.0147",
          "r": false,
          "t": { "limit": { "tif": "Ioc" } }
        }
      ],
      "grouping": "na"
    },
    "nonce": 1677777606040,
    "vault_address": null,
    "expires_after": null,
    "expected": {
      "connection_id": "0x0fcbeda5ae3c4950a548021552a4fea2226858c4453571bf3f24ba017eac2908"
    },
    "notes": "connection_id = keccak(msgpack(action) || nonce_be64 || 0x00). Source builds the action with order_request_to_order_wire({coin:'ETH', is_buy:True, sz:0.0147, limit_px:1670.1, reduce_only:False, order_type:{limit:{tif:'Ioc'}}, cloid:None}, asset=4). No private key involved; construct_phantom_agent(hash, True) only sets source='a'."
  },
  {
    "name": "py/test_l1_action_signing_matches/mainnet",
    "source_url": "https://github.com/hyperliquid-dex/hyperliquid-python-sdk/blob/master/tests/signing_test.py",
